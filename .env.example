# Portal 3e — copie para .env.local e preencha.
# .env.local está no .gitignore. Nunca commite chave real.

# ------------------------------------------------------------------
# Supabase — painel do projeto > Settings > API
# ------------------------------------------------------------------
# Vão para o browser. Podem ser públicas: quem protege o dado é a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. Só server. Nunca prefixe com NEXT_PUBLIC_ (CLAUDE.md, invariante 2).
SUPABASE_SERVICE_ROLE_KEY=

# Usado pelo CLI: supabase link --project-ref / db push / gen types.
SUPABASE_PROJECT_REF=

# Senha do banco, para migração e geração de tipos fora do link interativo.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
# Base absoluta para link de e-mail (primeiro acesso, recuperação de senha).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug da organização desta instalação. Monta o e-mail sintético do
# funcionário no login: <cpf>@func.<slug>.portal3e (docs/03). Só server —
# nunca prefixe com NEXT_PUBLIC_.
ORG_SLUG=3e

# ------------------------------------------------------------------
# E-mail — Resend
# ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE="Portal 3e <nao-responda@exemplo.com.br>"
