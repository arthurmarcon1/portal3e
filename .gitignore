# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# alvo alternativo da suíte de integração (ver CLAUDE.md)
.env.test.local

# espelhos fictícios gerados por scripts/gerar-espelhos-demo.mjs
/demo/

# backup do banco de produção (scripts/backup-producao.mjs) — dado pessoal de
# funcionário real. NUNCA entra no repositório. O padrão do script é fora daqui
# (~/portal3e-backups); estas linhas são a segunda barreira, para --saida=backups
# ou um arquivo copiado para cá por engano.
/backups/
portal3e-*-dados.sql
portal3e-*-esquema.sql
*.sql.gpg
